{
  "name": "qemu_user",
  "description": "QEMU user 运行目标二进制(显式 arch/binary/rootfs/argv;aarch64 自动优先 state/tools.json 的 qemu-aarch64-patched,也可显式 qemu=)",
  "input_schema": {
    "type": "object",
    "properties": {
      "arch": {"type": "string", "enum": ["x86_64", "aarch64", "arm", "mipsel", "mips"]},
      "binary": {"type": "string"},
      "rootfs": {"type": "string"},
      "qemu": {"type": "string", "description": "可选 qemu 可执行文件/名称(如 qemu-aarch64-patched)"},
      "argv": {"type": "array", "items": {"type": "string"}},
      "timeout": {"type": "number"}
    },
    "required": ["arch", "binary"]
  },
  "kind": "python",
  "adapter": "fwcore.adapters_qemu:run",
  "timeout": 30,
  "timeout_arg": "timeout",
  "risk": "high",
  "capability": "emu.user",
  "provider": "qemu-user"
}
