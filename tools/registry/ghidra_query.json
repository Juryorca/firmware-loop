{
  "name": "ghidra_query",
  "description": "Ghidra 无头分析:显式 project/name/binary/script/script_args;输出脚本产物",
  "input_schema": {
    "type": "object",
    "properties": {
      "project": {"type": "string", "description": "Ghidra 项目目录(不能含 . 开头路径元素)"},
      "name": {"type": "string", "description": "项目名"},
      "binary": {"type": "string", "description": "待分析二进制"},
      "script": {"type": "string", "description": "Ghidra 脚本名,如 ProfileFuncs.java"},
      "script_args": {"type": "array", "items": {"type": "string"}},
      "cleanup": {"type": "boolean"},
      "timeout": {"type": "number"}
    },
    "required": ["project", "name", "binary", "script"]
  },
  "kind": "python",
  "adapter": "fwcore.adapters_ghidra:run",
  "timeout": 300,
  "timeout_arg": "timeout",
  "risk": "high",
  "capability": "debug.ghidra",
  "provider": "repo:ghidra_run.sh",
  "observer": "ghidra_query",
  "requires_file": "tools/ghidra_run.sh",
  "capability_required": "debug.ghidra"
}
