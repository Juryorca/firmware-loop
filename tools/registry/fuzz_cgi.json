{
  "name": "fuzz_cgi",
  "description": "对厂商 CGI 做有界变异 fuzz(显式 cgi/rootfs/shim/rounds;高风险,需确认)",
  "input_schema": {
    "type": "object",
    "properties": {
      "cgi": {"type": "string", "description": "目标 CGI 二进制"},
      "rootfs": {"type": "string", "description": "rootfs 路径"},
      "shim": {"type": "string", "description": "可选 shim 库目录"},
      "rounds": {"type": "number", "description": "变异轮数"},
      "timeout": {"type": "number"}
    },
    "required": ["cgi", "rootfs"]
  },
  "kind": "script",
  "argv": [
    "bash",
    "tools/cgi_fuzz.sh",
    "{cgi}",
    "{rootfs}",
    "{shim}",
    "{rounds}"
  ],
  "timeout": 300,
  "timeout_arg": "timeout",
  "observer": "fuzz_cgi",
  "risk": "high",
  "capability": "fuzz.cgi",
  "provider": "repo:cgi_fuzz.sh",
  "requires_file": "tools/cgi_fuzz.sh"
}
