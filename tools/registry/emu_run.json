{
  "name": "emu_run",
  "description": "[legacy] 历史 strace 仿真入口;新调用用 qemu_user(显式 binary/rootfs/argv)。高风险,需确认",
  "input_schema": {
    "type": "object",
    "properties": {
      "args": {
        "type": "string"
      },
      "timeout": {
        "type": "number"
      }
    },
    "required": [
      "args"
    ]
  },
  "kind": "script",
  "argv": [
    "bash",
    "tools/emu_run.sh",
    "{args}"
  ],
  "split_args": [
    "args"
  ],
  "timeout": 180,
  "timeout_arg": "timeout",
  "observer": "emu_run",
  "risk": "high",
  "capability": "emu.run",
  "provider": "repo:emu_run.sh",
  "requires_file": "tools/emu_run.sh"
}