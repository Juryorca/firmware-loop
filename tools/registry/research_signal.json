{
  "name": "research_signal",
  "description": "按仓库信号约定判读 strace/仿真日志(命令注入/崩溃);返回 HIT/MISS 与依据(MISS 退出码 1 = 有意义的负结果)",
  "input_schema": {
    "type": "object",
    "properties": {
      "log": {
        "type": "string"
      }
    },
    "required": [
      "log"
    ]
  },
  "kind": "script",
  "argv": [
    "python3",
    "tools/parse_signal.py",
    "{log}"
  ],
  "timeout": 60,
  "observer": "research_signal",
  "capability": "signal.parse",
  "provider": "repo:parse_signal.py",
  "requires_file": "tools/parse_signal.py",
  "ok_exit_codes": [
    0,
    1
  ]
}